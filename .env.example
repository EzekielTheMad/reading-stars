# Generate .env with: node scripts/configure.mjs
# Never commit .env. Real installations have no default password or parent PIN.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
PUBLIC_ORIGIN=http://127.0.0.1:8787
COOKIE_SECURE=false
SETUP_TOKEN=
# Set before the first rewarded finish. Use an IANA timezone, e.g. Europe/London.
READING_TIME_ZONE=UTC
# Compose-only settings; leave loopback binding when using a local reverse proxy.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8787
# Optional paid AI preparation. Manual books/questions work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_SEARCH_MODEL=gpt-5.5
AI_DAILY_LIMIT=10
